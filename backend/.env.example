# Copy to backend/.env and fill in. .env is gitignored - never commit real keys.

# --- Required: Gemini / Google GenAI ---------------------------------------
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=
GEMINI_API_KEY=

# Optional - LLM model id for every agent (default: gemini-3.5-flash).
GEMINI_MODEL=gemini-3.5-flash

# --- Optional: real (non-mock) Cloud Run deployment via per-user OAuth ------
# Web application OAuth client (APIs & Services > Credentials) with redirect URI
#   http://localhost:8080/api/gcloud/oauth/callback
# and scopes: openid, email, https://www.googleapis.com/auth/cloud-platform
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:8080
FRONTEND_BASE_URL=http://localhost:3000

# --- Optional: session cookie cross-site policy ----------------------------
# Leave "lax" for local dev. Set "none" (Secure is then forced) if backend and
# frontend are served from different domains.
COOKIE_SAMESITE=lax
COOKIE_SECURE=

# --- Optional: encrypt OAuth tokens at rest (Fernet) ----------------------
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Optional: path overrides (default: repo-relative) --------------------
# S2C_DB_PATH=
# S2C_WORKSPACE_ROOT=
# S2C_UPLOAD_DIR=
